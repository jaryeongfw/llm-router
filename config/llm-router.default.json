{
  "roster": "config/roster.json",
  "taxonomy": "config/taxonomy.json",
  "rules": "config/sensitivity-rules.json",
  "routing_table": "config/routing-table.v0.json",
  "mode": "A",
  "pin_scope": "query",
  "tool_result_policy": "warn",
  "local_models": [],
  "default_tier": "heavy",
  "direct_tier": "light",
  "side_effect_floor": "heavy",
  "low_confidence": 0.5,
  "decision_timeout_ms": 15000,
  "analyzer": {
    "prefer": "local",
    "model": null,
    "claude_auto": true,
    "timeout_ms": 12000,
    "max_tokens": 4096,
    "mask_secrets": true,
    "suspicion_without_local": "warn",
    "followup_max_chars": 60
  },
  "secret_policy": {
    "mode": "mask",
    "tier": "heavy"
  },
  "verifiable_down": {
    "max_difficulty": 0,
    "confident_max_difficulty": 0,
    "min_confidence": 1
  },
  "virtual_levels": {
    "low": "economy",
    "medium": "balanced",
    "high": "quality"
  },
  "operating_points": {
    "economy": {
      "thinking_shift": -1,
      "allow_verifiable_down": true,
      "tier_shift": 0
    },
    "balanced": {
      "thinking_shift": 0,
      "allow_verifiable_down": true,
      "tier_shift": 0
    },
    "quality": {
      "thinking_shift": 1,
      "allow_verifiable_down": false,
      "tier_shift": 0
    }
  },
  "thinking_rules": {
    "reasoning_up_at": 3,
    "max_thinking": "xhigh"
  },
  "internal_markers": {
    "domains": [],
    "path_prefixes": [],
    "keywords": []
  },
  "log_dir": "~/.pi/agent/llm-router"
}
