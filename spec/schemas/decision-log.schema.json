{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-log.schema.json",
  "title": "결정 로그 한 줄 (원문 미저장)",
  "type": "object",
  "required": [
    "v",
    "decision_id",
    "task_id",
    "ts",
    "prompt_hash",
    "analysis",
    "decision",
    "latency_ms"
  ],
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "decision_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "ts": {
      "type": "string"
    },
    "prompt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "analysis": {
      "$ref": "analysis.schema.json"
    },
    "decision": {
      "type": "object",
      "required": [
        "tier",
        "model",
        "base_tier",
        "adjustments",
        "capped",
        "ask_user",
        "reason",
        "thinking",
        "base_thinking",
        "thinking_adjustments",
        "operating_point"
      ],
      "additionalProperties": false,
      "properties": {
        "tier": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "model": {
          "$ref": "common.schema.json#/$defs/model_ref"
        },
        "base_tier": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "table_cell": {
          "type": [
            "string",
            "null"
          ]
        },
        "adjustments": {
          "type": "array",
          "items": {
            "enum": [
              "side_effect_floor",
              "scope_up",
              "low_confidence_up",
              "verifiable_down",
              "capability_filter",
              "context_filter",
              "sensitivity_filter"
            ]
          }
        },
        "capped": {
          "type": "boolean"
        },
        "ask_user": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "fallback_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "thinking": {
          "$ref": "common.schema.json#/$defs/thinking"
        },
        "base_thinking": {
          "$ref": "common.schema.json#/$defs/thinking"
        },
        "operating_point": {
          "$ref": "common.schema.json#/$defs/operating_point"
        },
        "thinking_adjustments": {
          "type": "array",
          "items": {
            "enum": [
              "reasoning_up",
              "verifiable_down",
              "operating_point_shift",
              "clamped_to_model",
              "local_off"
            ]
          }
        }
      }
    },
    "latency_ms": {
      "type": "object",
      "required": [
        "stage1",
        "stage2",
        "total"
      ],
      "additionalProperties": false,
      "properties": {
        "stage1": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "stage2": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
