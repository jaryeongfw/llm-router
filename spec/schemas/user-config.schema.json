{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user-config.schema.json",
  "title": "사용자 설정 (~/.pi/agent/llm-router.json). 적은 항목만 기본값을 덮어쓴다",
  "type": "object",
  "required": [],
  "additionalProperties": false,
  "properties": {
    "roster": {
      "type": "string"
    },
    "taxonomy": {
      "type": "string"
    },
    "rules": {
      "type": "string"
    },
    "routing_table": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "default_tier": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "direct_tier": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "side_effect_floor": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "low_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "decision_timeout_ms": {
      "type": "integer",
      "minimum": 0
    },
    "analyzer": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "prefer": {
          "enum": [
            "local",
            "claude"
          ],
          "description": "외부 전송 가능한 요청에서 먼저 시도할 판단 모델. 로컬 전용 요청은 항상 local만"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/model_ref"
            },
            {
              "type": "null"
            }
          ],
          "description": "판단 모델을 직접 지정 (쓸 수 없으면 무시)"
        },
        "claude_auto": {
          "type": "boolean",
          "description": "쓸 수 있는 Claude 모델 중 판단 모델을 자동 선택 (haiku 최신 우선)"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 0
        },
        "mask_secrets": {
          "type": "boolean"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 256,
          "description": "판단 모델 출력 상한. 추론형 모델은 사고 과정이 먼저 나오므로 넉넉하게"
        }
      }
    },
    "internal_markers": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path_prefixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "log_dir": {
      "type": "string"
    },
    "virtual_levels": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "low": {
          "$ref": "common.schema.json#/$defs/operating_point"
        },
        "medium": {
          "$ref": "common.schema.json#/$defs/operating_point"
        },
        "high": {
          "$ref": "common.schema.json#/$defs/operating_point"
        }
      },
      "description": "virtual model에서 고른 thinking level을 운영점으로 해석한다"
    },
    "operating_points": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "economy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "thinking_shift",
            "allow_verifiable_down"
          ],
          "properties": {
            "thinking_shift": {
              "type": "integer",
              "minimum": -2,
              "maximum": 2
            },
            "allow_verifiable_down": {
              "type": "boolean"
            },
            "tier_shift": {
              "type": "integer",
              "minimum": -1,
              "maximum": 1
            }
          }
        },
        "balanced": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "thinking_shift",
            "allow_verifiable_down"
          ],
          "properties": {
            "thinking_shift": {
              "type": "integer",
              "minimum": -2,
              "maximum": 2
            },
            "allow_verifiable_down": {
              "type": "boolean"
            },
            "tier_shift": {
              "type": "integer",
              "minimum": -1,
              "maximum": 1
            }
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "thinking_shift",
            "allow_verifiable_down"
          ],
          "properties": {
            "thinking_shift": {
              "type": "integer",
              "minimum": -2,
              "maximum": 2
            },
            "allow_verifiable_down": {
              "type": "boolean"
            },
            "tier_shift": {
              "type": "integer",
              "minimum": -1,
              "maximum": 1
            }
          }
        }
      }
    },
    "thinking_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "reasoning_up_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "max_thinking": {
          "$ref": "common.schema.json#/$defs/thinking"
        }
      }
    },
    "secret_policy": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "mask",
            "heavy",
            "block"
          ],
          "description": "mask: 모든 모델 호출에서 가리고 티어는 평소대로 / heavy: tier로 강제 배정 / block: 차단"
        },
        "tier": {
          "$ref": "common.schema.json#/$defs/id",
          "description": "mode=heavy일 때 배정 티어"
        }
      },
      "description": "비밀정보 포함 태스크 처리 (07-spec §6.5)"
    },
    "verifiable_down": {
      "type": "object",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "max_difficulty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "confident_max_difficulty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "pin_scope": {
      "enum": [
        "query",
        "session"
      ],
      "description": "query: 사용자 쿼리마다 다시 결정 / session: 세션 첫 쿼리 결정을 유지"
    },
    "local_models": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "common.schema.json#/$defs/model_ref"
          },
          {
            "type": "object",
            "required": [
              "ref"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "$ref": "common.schema.json#/$defs/model_ref"
              },
              "context_window": {
                "type": "integer"
              },
              "max_output": {
                "type": "integer"
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/capability"
                }
              },
              "thinking_levels": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/thinking"
                }
              }
            }
          }
        ]
      },
      "description": "local 티어에 넣을 로컬 모델 (앞에서부터 primary, fallback)"
    },
    "$comment": {
      "type": "string"
    }
  }
}
