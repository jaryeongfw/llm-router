{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taxonomy.schema.json",
  "title": "도메인 × 행위 분류",
  "type": "object",
  "required": [
    "version",
    "domains",
    "actions"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "includes",
          "excludes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "includes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excludes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "crb_mapping": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "includes",
          "excludes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "includes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excludes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "crb_mapping": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
