{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plugin-config.schema.json",
  "title": "플러그인 설정",
  "type": "object",
  "required": [
    "roster",
    "taxonomy",
    "rules",
    "routing_table",
    "mode",
    "default_tier",
    "direct_tier",
    "side_effect_floor",
    "low_confidence",
    "decision_timeout_ms",
    "analyzer",
    "internal_markers",
    "log_dir",
    "virtual_levels",
    "operating_points",
    "thinking_rules",
    "secret_policy",
    "verifiable_down"
  ],
  "additionalProperties": false,
  "properties": {
    "roster": {
      "type": "string"
    },
    "taxonomy": {
      "type": "string"
    },
    "rules": {
      "type": "string"
    },
    "routing_table": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "default_tier": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "direct_tier": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "side_effect_floor": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "low_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "decision_timeout_ms": {
      "type": "integer",
      "minimum": 0
    },
    "analyzer": {
      "type": "object",
      "required": [
        "external_ok",
        "internal_only",
        "timeout_ms",
        "mask_secrets"
      ],
      "additionalProperties": false,
      "properties": {
        "external_ok": {
          "$ref": "common.schema.json#/$defs/analyzer_route"
        },
        "internal_only": {
          "$ref": "common.schema.json#/$defs/analyzer_route"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 0
        },
        "mask_secrets": {
          "type": "boolean"
        }
      },
      "description": "1단 민감도 판정에 따라 분석기를 고른다. internal_only 요청은 사내 분석기만"
    },
    "internal_markers": {
      "type": "object",
      "required": [
        "domains",
        "path_prefixes",
        "keywords"
      ],
      "additionalProperties": false,
      "properties": {
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "path_prefixes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "log_dir": {
      "type": "string"
    },
    "virtual_levels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low",
        "medium",
        "high"
      ],
      "properties": {
        "low": {
          "$ref": "common.schema.json#/$defs/operating_point"
        },
        "medium": {
          "$ref": "common.schema.json#/$defs/operating_point"
        },
        "high": {
          "$ref": "common.schema.json#/$defs/operating_point"
        }
      },
      "description": "virtual model에서 고른 thinking level을 운영점으로 해석한다"
    },
    "operating_points": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "economy",
        "balanced",
        "quality"
      ],
      "properties": {
        "economy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "thinking_shift",
            "allow_verifiable_down"
          ],
          "properties": {
            "thinking_shift": {
              "type": "integer",
              "minimum": -2,
              "maximum": 2
            },
            "allow_verifiable_down": {
              "type": "boolean"
            },
            "tier_shift": {
              "type": "integer",
              "minimum": -1,
              "maximum": 1
            }
          }
        },
        "balanced": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "thinking_shift",
            "allow_verifiable_down"
          ],
          "properties": {
            "thinking_shift": {
              "type": "integer",
              "minimum": -2,
              "maximum": 2
            },
            "allow_verifiable_down": {
              "type": "boolean"
            },
            "tier_shift": {
              "type": "integer",
              "minimum": -1,
              "maximum": 1
            }
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "thinking_shift",
            "allow_verifiable_down"
          ],
          "properties": {
            "thinking_shift": {
              "type": "integer",
              "minimum": -2,
              "maximum": 2
            },
            "allow_verifiable_down": {
              "type": "boolean"
            },
            "tier_shift": {
              "type": "integer",
              "minimum": -1,
              "maximum": 1
            }
          }
        }
      }
    },
    "thinking_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasoning_up_at",
        "max_thinking"
      ],
      "properties": {
        "reasoning_up_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "max_thinking": {
          "$ref": "common.schema.json#/$defs/thinking"
        }
      }
    },
    "secret_policy": {
      "type": "object",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "mask",
            "heavy",
            "block"
          ],
          "description": "mask: 모든 모델 호출에서 가리고 티어는 평소대로 / heavy: tier로 강제 배정 / block: 차단"
        },
        "tier": {
          "$ref": "common.schema.json#/$defs/id",
          "description": "mode=heavy일 때 배정 티어"
        }
      },
      "description": "비밀정보 포함 태스크 처리 (07-spec §6.5)"
    },
    "verifiable_down": {
      "type": "object",
      "required": [
        "max_difficulty",
        "confident_max_difficulty",
        "min_confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "max_difficulty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "confident_max_difficulty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
