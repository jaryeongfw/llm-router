{
  "budget": {
    "max_turns": 40,
    "timeout_s": 900
  },
  "id": "orders-review-bulk-cancel",
  "fixture": "orders-service",
  "task_type": {
    "domain": "backend",
    "action": "review"
  },
  "summary": "diff 리뷰 (심어 둔 결함 3개)",
  "prompt": "CHANGE.diff에 있는 변경을 리뷰해 주세요. 결함이나 위험이 있으면 위치와 이유, 고치는 방법을 알려 주세요. 파일은 수정하지 마세요.",
  "rewrites": [
    "루트의 CHANGE.diff 코드 리뷰 부탁드립니다. 문제점마다 위치·이유·수정 제안을 적어 주세요. 코드는 바꾸지 말고요.",
    "CHANGE.diff PR 리뷰해줘. 버그/리스크 위주로, 수정은 하지 말고 코멘트만."
  ],
  "labels": {
    "hard_constraints": {
      "data_sensitivity": "external_ok",
      "irreversible_side_effects": false,
      "required_capabilities": [
        "tool_use"
      ],
      "latency": "interactive",
      "budget_cap_usd": null
    },
    "dimensions": {
      "difficulty": 2,
      "ambiguity": 0,
      "scope": 1,
      "verifiability": 2,
      "consistency": 1,
      "capabilities": {
        "long_context": 0,
        "multi_step_tools": 1,
        "code_correctness": 2,
        "instruction_following": 1,
        "korean_writing": 1,
        "reasoning": 2
      }
    }
  },
  "verification": {
    "type": "rubric",
    "rubric": [
      {
        "id": "off_by_one",
        "criterion": "bulkCancel의 반복 조건 `i <= orderIds.length`가 범위를 넘어 마지막에 undefined ID로 cancelOrder를 호출하는 문제를 지적한다",
        "must": true
      },
      {
        "id": "non_atomic",
        "criterion": "bulkCancel이 중간에 실패하면 앞서 취소된 주문은 취소된 채 남아(부분 적용) 호출자가 알 수 없다는 점을 지적한다",
        "must": true
      },
      {
        "id": "float_money",
        "criterion": "promoTotal이 `subtotal * 0.07`을 내림 없이 써서 원 단위가 아닌 금액이 나오는 문제를 지적한다",
        "must": true
      },
      {
        "id": "promo_base",
        "criterion": "프로모션 할인을 이미 할인·배송비가 반영된 total에서 subtotal 기준 금액으로 빼는 기준 불일치(정책 근거 없음)를 지적하거나 질문한다",
        "must": false
      },
      {
        "id": "no_false_positive",
        "criterion": "존재하지 않는 결함을 단정적으로 주장하지 않는다",
        "must": true
      },
      {
        "id": "actionable",
        "criterion": "지적마다 구체적인 수정 방법을 제시한다",
        "must": false
      }
    ],
    "pass_threshold": 0.75
  },
  "expected_tier_hypothesis": "heavy",
  "expected_thinking_hypothesis": "medium"
}
