{
  "name": "llm-router",
  "version": "0.1.0",
  "private": true,
  "description": "pi 플러그인: 태스크를 분석해 충분히 잘하는 가장 싼 모델 티어에 고정 배정한다",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "validate": "node scripts/validate-data.ts",
    "derive": "node scripts/derive-hypotheses.ts",
